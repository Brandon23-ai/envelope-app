# URL base del backend (NestJS). Sin barra final.
#
# IMPORTANTE: "localhost" no funciona desde un dispositivo físico ni desde la
# mayoría de los emuladores, porque "localhost" ahí apunta al propio
# dispositivo/emulador, no a tu máquina.
#   - Dispositivo físico o emulador iOS: usá la IP de tu máquina en la red
#     local, por ejemplo http://192.168.1.50:3000
#   - Emulador de Android: usá http://10.0.2.2:3000 (alias especial del
#     emulador hacia el host)
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Client IDs de Google Cloud (OAuth). Vacíos hasta que se creen las
# credenciales — con estos vacíos, el botón de Google se muestra pero avisa
# que la función no está configurada en vez de intentar autenticar.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
