# Normaliza finales de línea: LF en el repo y en el working tree.
# Evita el ruido de "LF will be replaced by CRLF" en Windows.
* text=auto eol=lf

# Scripts que Windows necesita con CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: que git no los toque
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
